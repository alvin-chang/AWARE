# Dockerfile.gateway — AWARE 2.0 gateway
# Per ADR (internal) Phase 1, option A: thin BFF/proxy in front of the coordinator.
# Multi-stage build: deps installed in builder stage, runtime stage is minimal.
# Runs as non-root `aware` user. Healthcheck via wget /health on the gateway itself.
#
# Build with:
#   DOCKER_BUILDKIT=1 docker build \
#     -f Dockerfile.gateway \
#     -t aware-gateway:0.2.0-ollama-removed \
#     .
#
# Source-tree closure (verified by python3 walk from src/gateway + src/api seeds):
#   gateway needs:  agents, api, audit, compliance, config, election,
#                   gateway, kill-switch, monitoring, policies, routing
#   gateway does NOT need:  coordinator, budget, trainer, db, training, ui, data
# Keeping the gateway image minimal (no coordinator ESM service, no training
# pipeline, no UI bundle) keeps the attack surface small AND avoids loading
# modules that would crash with their native deps (pg, modal, etc.).
#
# We use the coordinator's package.json (not package.gateway.json) because
# the gateway's audit.js / kill-switch.js routes now share the same dep tree
# as the coordinator. The coordinator's package.json has all the runtime
# deps needed by the gateway, none missing.

# ─── Builder ────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /build

# Copy the AWARE package manifest (NOT package.gateway.json — we share deps).
COPY package.json ./package.json

# Install production deps. The runtime image copies node_modules wholesale,
# so we don't need to worry about dev deps.
RUN npm install --omit=dev --no-audit --no-fund --loglevel=error

# ─── Runtime ────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime

# wget is needed for the HEALTHCHECK. node:22-alpine has it; no apk add.
# bash is needed for the entrypoint; it ships with alpine.

# Create non-root user. The coordinator uses `aware` for the same reason.
RUN addgroup -S aware && adduser -S aware -G aware

WORKDIR /app

# Copy the built node_modules from the builder stage.
COPY --from=builder --chown=aware:aware /build/node_modules ./node_modules

# Copy package.json (so child src/audit/package.json with type:commonjs finds
# its parent's package.json no — actually src/audit/package.json stands alone
# with {"type":"commonjs"}, but the runtime also needs the top-level package.json
# for the npm-installed binary resolution).
COPY --chown=aware:aware package.json ./package.json

# Copy the gateway source plus every shared module it transitively requires.
# Source tree closure derived by recursive require/import walk from
# src/gateway and src/api entry points.
COPY --chown=aware:aware src/gateway      ./src/gateway
COPY --chown=aware:aware src/api          ./src/api
COPY --chown=aware:aware src/config       ./src/config
COPY --chown=aware:aware src/audit        ./src/audit
COPY --chown=aware:aware src/agents       ./src/agents
COPY --chown=aware:aware src/compliance   ./src/compliance
COPY --chown=aware:aware src/election     ./src/election
COPY --chown=aware:aware src/kill-switch  ./src/kill-switch
COPY --chown=aware:aware src/monitoring   ./src/monitoring
COPY --chown=aware:aware src/policies     ./src/policies
COPY --chown=aware:aware src/routing      ./src/routing
COPY --chown=aware:aware src/engine-secret.js ./src/engine-secret.js

# T0-T4 enforcement defaults. The gateway does not enforce T0-T4 itself
# (the coordinator does that) but the kill-switch env var is read on
# every request, so we set a default of 0 (off).
ENV NODE_ENV=production \
    GATEWAY_HOST=0.0.0.0 \
    GATEWAY_PORT=18080 \
    COORDINATOR_URL=http://coordinator:8080 \
    AWARE_GATEWAY_KILL_SWITCH=0 \
    GATEWAY_PROXY_TIMEOUT_MS=120000

USER aware

EXPOSE 18080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:18080/health || exit 1

CMD ["node", "src/gateway/server.js"]
