#!/bin/bash
# scripts/hooks/pre-push — Layer 2 of the AWARE 4-layer privacy filter
# (see docs/security/filter-architecture.md).
#
# Hard-blocks `git push` if the changes being pushed would re-introduce
# any of the privacy patterns the [date-redacted] audit flagged.
#
# Differences from Layer 1 (pre-commit):
#   - Scans the *full diff* being pushed (not just staged content)
#   - Runs `gitleaks detect` against the working tree (catches patterns
#     outside staged content, e.g. files modified but not staged)
#   - Loops over every ref being pushed (branch + tag)
#
# Bypassability: still client-side. `git push --no-verify` skips it.
# Layer 3 (gitea pre-receive) is the server-side last line of defense.
#
# Input: git pre-push passes "<local-ref> <local-sha> <remote-ref> <remote-sha>"
# one per line on stdin (see `man gittutorial-2` / `man githooks`).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT"

REMOTE="$1"   # destination remote name (e.g. "origin")
URL="$2"      # destination URL (e.g. "http://...alvin/aware.git")

echo "==> [Layer 2/3] pre-push to $REMOTE ($URL)"
echo "    Full re-scan + gitleaks against ALL changed refs"

FAILED=0

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "  (gitleaks not installed — skipping gitleaks scan. Install: brew install gitleaks)"
fi

# 1) For every ref being pushed, scan the new content being introduced.
#    We compare <local-sha>..<remote-sha> (or <local-sha> for new refs)
#    and grep the patch for the A1 content rules.
#
#    Bug-fix history:
#      v1 (in v2.7.2): ran `gitleaks detect --source . --no-git` against the
#        full working tree, producing false positives on gitignored files
#        (`.env`, `node_modules/*/README.md`, etc.) that the push would
#        never carry.
#      v2 (in v2.7.3 first attempt): piped changed-file paths via stdin to
#        `gitleaks detect`. This does NOT scope the scan in gitleaks 8.x —
#        gitleaks treats positional file arguments as advisory and still
#        scans `--source .` (or `.` by default) recursively. End result:
#        same 38 false positives in node_modules/*.
#      v3 (this version): invoke `gitleaks detect --source <file>` once per
#        changed file. Each call scans exactly that file (no directory
#        descent), so gitignored content is excluded by construction.
#        Cost: O(N) gitleaks invocations per ref. For the AWARE repo (a few
#        dozen changed files per release) this is ~1s total — acceptable.
echo "    Scanning diffs of pushed refs..."
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    # Skip empty lines
    [[ -z "$LOCAL_REF" ]] && continue

    # New branch (no remote SHA yet) — compare against the most recent
    # ancestor that already exists on the remote (so we don't re-scan
    # every file in the tree for a new tag).
    if [[ -z "$REMOTE_SHA" || "$REMOTE_SHA" =~ ^0+$ ]]; then
        # Find the most recent commit reachable from LOCAL_SHA that exists
        # on any remote-tracking ref. Use that as the diff base.
        DIFF_BASE="$(git merge-base --octopus "$LOCAL_SHA" $(git for-each-ref --format='%(objectname)' refs/remotes/ 2>/dev/null) 2>/dev/null | head -1 || true)"
        if [[ -z "$DIFF_BASE" || "$DIFF_BASE" =~ ^0+$ ]]; then
            # No common ancestor with any remote (fully new repo / first push).
            # Fall back to the diff vs an empty tree — this WILL scan every
            # tracked file. Acceptable for a bootstrap push.
            RANGE_OR_TREE="$(git hash-object -t tree /dev/null 2>/dev/null || true)"
            [[ -z "$RANGE_OR_TREE" ]] && RANGE_OR_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # well-known empty-tree SHA
            RANGE_OR_TREE="$RANGE_OR_TREE..$LOCAL_SHA"
            RANGE_LABEL="(new ref: $LOCAL_REF, full diff vs empty tree)"
        else
            RANGE_OR_TREE="$DIFF_BASE..$LOCAL_SHA"
            RANGE_LABEL="(new ref: $LOCAL_REF, base=$DIFF_BASE)"
        fi
    else
        RANGE_OR_TREE="$REMOTE_SHA..$LOCAL_SHA"
        RANGE_LABEL="($REMOTE_REF..$LOCAL_REF)"
    fi

    echo "    -> $LOCAL_REF $RANGE_LABEL"

    # Get the list of changed files in this range
    CHANGED_FILES="$(git diff --name-only "$RANGE_OR_TREE" 2>/dev/null || true)"

    if [[ -z "$CHANGED_FILES" ]]; then
        continue
    fi

    # Run gitleaks against only the files being pushed in this ref's diff.
    # gitleaks 8.x ignores stdin-paths and always scans --source (or `.`)
    # recursively. Workaround: invoke gitleaks per-file with --source so
    # the scope is exactly the file we want to check. Gitignored files
    # never appear in `git diff`, so they're naturally excluded.
    #
    # Use absolute paths for both --source and --config: when scanning
    # `.gitleaks.toml` itself (its own rules contain the host-path/LAN-IP
    # regex patterns), a relative-path --source would cause gitleaks to
    # match its own rule definitions against themselves.
    if command -v gitleaks >/dev/null 2>&1; then
        FILE_COUNT="$(echo "$CHANGED_FILES" | wc -l | tr -d ' ')"
        echo "    -> gitleaks detect (per-file, $FILE_COUNT changed file(s))"
        PER_FILE_FAILED=0
        while IFS= read -r f; do
            [[ -z "$f" ]] && continue
            [[ ! -f "$f" ]] && continue   # file was deleted in this diff
            ABS_F="$REPO_ROOT/$f"
            if ! gitleaks detect --no-git \
                    --source "$ABS_F" \
                    --config "$REPO_ROOT/.gitleaks.toml" \
                    --redact --no-banner --exit-code 1 >/dev/null 2>&1; then
                echo ""
                echo "✗ pre-push blocked: gitleaks found a pattern in $f."
                echo "  See .gitleaks.toml for the rule that fired."
                PER_FILE_FAILED=1
            fi
        done <<< "$CHANGED_FILES"
        if [[ $PER_FILE_FAILED -eq 1 ]]; then
            FAILED=1
        fi
    fi

    # Run the same content checks the pre-commit hook runs, against changed files only.
    # This mirrors the A1 CI lint jobs.
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        # Only scan files that exist on disk
        if [[ ! -f "$f" ]]; then
            continue
        fi

        # Rule 1: docs/audits/*.md host-path patterns
        if [[ "$f" == docs/audits/*.md ]]; then
            if grep -E '(/Users/[a-z]+/|\.aws/|\.ssh/|\.kube/|\.docker/|\.gnupg/)' "$f" >/dev/null 2>&1; then
                echo "    ✗ $f — host-path pattern in docs/audits/"
                FAILED=1
            fi
        fi

        # Rule 2: STATUS.md LAN IP + secrets paths
        if [[ "$f" == "STATUS.md" ]]; then
            if grep -E '\b(192\.168\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})\b' "$f" >/dev/null 2>&1; then
                echo "    ✗ $f — LAN IP in STATUS.md"
                FAILED=1
            fi
            if grep -E '<redacted-credential-path>*\.env|api-keys\.env|credentials\.env' "$f" >/dev/null 2>&1; then
                echo "    ✗ $f — secrets path in STATUS.md"
                FAILED=1
            fi
        fi

        # Rule 3: src/data/*.json shape (not the .json.template)
        if [[ "$f" == "src/data/users.json" || "$f" == "src/data/agents.json" ]]; then
            echo "    ✗ $f is tracked in push. Only .json.template should be committed."
            FAILED=1
        fi
        if [[ "$f" == "src/data/users.json.template" || "$f" == "src/data/agents.json.template" ]]; then
            if grep -E '"passwordHash"|"credentials"' "$f" >/dev/null 2>&1; then
                echo "    ✗ $f contains passwordHash/credentials fields (should be generated, not committed)"
                FAILED=1
            fi
        fi
    done <<< "$CHANGED_FILES"
done

if [[ $FAILED -eq 1 ]]; then
    echo ""
    echo "✗ pre-push blocked. See docs/security/filter-architecture.md for the full filter spec."
    echo "  To override (NOT RECOMMENDED): git push --no-verify"
    exit 1
fi

echo "✓ Layer 2 (pre-push) passed."
exit 0
