# AWARE 2.0 — environment variable template
#
# This file documents the env vars the AWARE stack reads. The
# compose file's coordinator service is wired to read
# LLM_API_KEY and AWARE_POSTGRES_PASSWORD from the canonical
# credential store on this host:
#
#   ~/.<host-secret-dir>/ACTIVE-CREDENTIALS.env
#
# That file already contains LLM_API_KEY=*** (real value, mode
# 0600). The AWARE compose file references it via:
#
#   env_file:
#     - path: ${HOME}/.<host-secret-dir>/ACTIVE-CREDENTIALS.env
#       required: false
#
# So you don't need to do anything for the bring-up to find the
# key — the host's credential store is the source of truth, and the
# AWARE stack reads from it at compose-up time. This file is a
# reference for what the stack expects, not a value file.

# --- Model layer (required for online mode) ---
# Primary model client. Sourced from
# ~/.<host-secret-dir>/ACTIVE-CREDENTIALS.env by the compose file.
# Without this, the coordinator falls back to the Ollama sidecar
# and /coordinate returns 500 when mode is "online" or "hybrid"
# (because the primary tier is unreachable).
# LLM_API_KEY=replace-with-your-key

# Optional: override the API host. Default is the production host;
# only set this if you are testing against a different endpoint.
# MINIMAX_API_HOST=https://api.example.com/v1

# --- Persistence (defaults are dev-only) ---
# Postgres password. Sourced from the same canonical credential store.
# The compose file defaults to a dev-only value that
# scripts/check-prod.sh will refuse to deploy. In production, the
# canonical store should have a real password.
# AWARE_POSTGRES_PASSWORD=replace-with-your-password

# --- Coordinator auth (SC-CRITICAL-002, 2026-06-25 audit) ---
# Bearer-token required for /coordinate + /budget/status in production.
# Set AWARE_COORDINATOR_TOKEN to a random ≥32-char secret. The gateway
# (extensions/openclaw-plugin/.../gateway) must send the same token in
# the Authorization: Bearer *** header on outbound /coordinate calls.
# In NODE_ENV=production the coordinator refuses to boot without this
# set (config.validate() throws). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AWARE_COORDINATOR_TOKEN=replac...ng-32-char-secret

# Test/dev only — set to 1 to disable the auth gate. NEVER set this in
# production. The coordinator's test bootstrap uses this to keep the
# legacy no-auth test fixtures green while the dedicated auth tests
# (test/unit/coordinator/auth.test.js) verify the gate works.
# AWARE_COORDINATOR_AUTH_DISABLED=0

# --- v1 AWARE Engine SECRET_KEY (SC-CRITICAL-001, SC-CRITICAL-004) ---
# The v1 engine (src/index.js) and docker-compose.yml both require a
# SECRET_KEY ≥32 chars. SC-CRITICAL-001: src/index.js used to fail open
# with `|| 'default_secret'` — replaced with a fail-closed check that
# throws on missing or short secrets. SC-CRITICAL-004: docker-compose.yml
# used to default SECRET_KEY=*** — replaced with
# `${SECRET_KEY:?SECRET_KEY must be set}` so compose up fails fast if the
# env var is missing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production, set this in your secret store (e.g. /etc/aware/secrets.env,
# AWS Secrets Manager, HashiCorp Vault, Kubernetes Secret mounted via envFrom)
# and let the compose env_file: block pick it up. The v1 and v2 stacks can
# share the same key or use separate keys (separate keys are recommended for
# blast-radius isolation — a v1 secret leak doesn't expose v2 JWTs and vice
# versa).
# SECRET_KEY=replac...cret
