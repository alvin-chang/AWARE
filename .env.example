# AWARE 2.0 — environment variable template
#
# Copy to a runtime location and fill in the values. NEVER commit the
# populated file. The canonical credential store on this Mac is
# ~/.<host-secret-dir>/ACTIVE-CREDENTIALS.env, which is sourced by
# the parent shell. The compose file reads from one of:
#
#   (1) env_file: ./secrets/api-keys.env  (user-created, gitignored)
#   (2) env_file: ~/.<host-secret-dir>/ACTIVE-CREDENTIALS.env  (canonical)
#   (3) host shell env via ${VAR} interpolation in compose
#
# Path (2) is recommended — it eliminates duplication and means rotating
# the key in one place flows through to the AWARE stack.

# --- Model layer (required for online mode) ---
# Primary model client. Without this, the coordinator falls back to the
# Ollama sidecar and /coordinate returns 500 when mode is "online" or
# "hybrid" (because the primary tier is unreachable).
LLM_API_KEY=replace-with-your-minimax-key

# Optional: override the API host. Default is the production host;
# only set this if you are testing against a different endpoint.
# MINIMAX_API_HOST=https://api.example.com/v1

# --- Persistence (defaults are dev-only) ---
# Postgres password. The compose file defaults to a dev-only value that
# scripts/check-prod.sh will refuse to deploy. Set this to a real
# password in production.
AWARE_POSTGRES_PASSWORD=replace-with-your-postgres-password
