# AWARE Production Environment Configuration
# Copy this file to .env.production and update values for your deployment

# Node Configuration
NODE_ID=aware-node-1
DISCOVERY_PORT=41234
BROADCAST_PORT=41235
API_PORT=3000

# Network
NODE_LIST=

# Security - CHANGE THESE VALUES FOR PRODUCTION
SECRET_KEY=your_secure_secret_key_here_change_in_production

# Frontend
REACT_APP_API_URL=http://localhost:3000/api
