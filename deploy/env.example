# AWARE 2.0 — environment variable template
#
# Per ADR-020 Phase 5 (deliverable: "all env vars in a single template file"):
# This file is the canonical reference for every v2 env var the AWARE
# stack reads. Operator onboarding path:
#
#   1. cp deploy/env.example .env
#   2. $EDITOR .env  # uncomment + fill what you have; defaults are safe
#   3. npm run config:validate   # confirm the stack parses your .env
#   4. npm run config:show       # see the redacted config the stack will use
#   5. ./scripts/aware-up        # bring up the v2 stack
#
# Secrets (<redacted-credential-name>, AWARE_POSTGRES_PASSWORD, <redacted-credential-name>,
# <redacted-credential-name>) are SOURCED from the canonical credential store on
# this host:
#
#   <credential-store>/credentials.env
#
# The compose file's coordinator service is wired to read that file via
# `env_file: required: false`. You don't need to copy secrets into .env
# for a normal bring-up — the host's credential store is the source of
# truth, and the AWARE stack reads from it at compose-up time. This file
# is a reference for what the stack expects, not a value file.
#
# All values shown below are the DEFAULTS the stack uses when the
# variable is unset. To override, uncomment the line and change the
# value. To use a different value than the default, you must SET the
# variable (uncommented or via shell).
#
# Last verified against src/config/index.cjs @ 5fa4f9a (Phase 5 R3
# bring-up script commit). If you add a new env var, add it to the
# matching section here AND to src/config/index.cjs, then re-run
# `npm run config:validate` to confirm the validator knows about it.

# ─────────────────────────────────────────────────────────────────────
# Coordinator HTTP service
# ─────────────────────────────────────────────────────────────────────
# The coordinator is the inner request router. Default port 8080 inside
# the container, exposed on host 18081 by docker-compose.coordinator.yml.
# COORDINATOR_PORT=8080
# COORDINATOR_HOST=127.0.0.1
# AWARE_REQUEST_TIMEOUT_MS=120000
# AWARE_REQUEST_COST_CAP_USD=1.0
# AWARE_KILL_SWITCH=false

# ─────────────────────────────────────────────────────────────────────
# Gateway HTTP service
# ─────────────────────────────────────────────────────────────────────
# The gateway is the outer BFF/proxy that the Telegram channel + A2A
# plugin hit. Default port 18080.
# GATEWAY_PORT=18080
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PROXY_TIMEOUT_MS=120000
# COORDINATOR_URL=http://coordinator:8080
# AWARE_GATEWAY_KILL_SWITCH=false

# ─────────────────────────────────────────────────────────────────────
# Model layer
# ─────────────────────────────────────────────────────────────────────
# AWARE_MODE selects the primary tier: online (MINIMAX API), hybrid
# (MINIMAX with Ollama fallback), or offline (Ollama only).
# AWARE_MODE=hybrid
#
# Primary model client. Sourced from
# <credential-store>/credentials.env by the compose file.
# Without this, the coordinator falls back to the Ollama sidecar and
# /coordinate returns 500 when mode is "online" or "hybrid" (because
# the primary tier is unreachable).
# <redacted-credential-name>=replace-with-your-key
#
# Optional: override the API host. Default is the production host; only
# set this if you are testing against a different endpoint. See
# src/config/index.cjs for the canonical env var name; historically
# named MINIMAX_API_HOST.
#
# Ollama sidecar. Default points at the v2 sidecar on host 18081.
# OLLAMA_URL=http://127.0.0.1:11434

# ─────────────────────────────────────────────────────────────────────
# Heavy-think (sibling repo, AZR self-play + DPO dataset formatting)
# ─────────────────────────────────────────────────────────────────────
# Path to <heavy-think-source>/src/index.js. Default resolves to the
# sibling-repo layout. Override only if heavy-think lives elsewhere.
# AWARE_HEAVY_THINK_PATH=<repo-root>/src/index.js

# ─────────────────────────────────────────────────────────────────────
# Postgres (Phase 2.1 conversation logger + 2.2 PRM cache + 2.3 budget)
# ─────────────────────────────────────────────────────────────────────
# `enabled=false` makes the logger a no-op; useful for offline dev.
# AWARE_DB_HOST=127.0.0.1
# AWARE_DB_PORT=5432
# AWARE_DB_DATABASE=aware2
# AWARE_DB_USER=aware
#
# Password is sourced from the canonical credential store
# (<credential-store-file>). The compose file defaults to a dev-only
# value that scripts/check-prod.sh will refuse to deploy. In production,
# the canonical store should have a real password.
# AWARE_POSTGRES_PASSWORD=replace-with-your-password
# AWARE_DB_ENABLED=true
# AWARE_DB_CONNECTION_TIMEOUT_MS=2000

# ─────────────────────────────────────────────────────────────────────
# PRM score cache (Phase 2.2)
# ─────────────────────────────────────────────────────────────────────
# When enabled=false the cache is a no-op and every /coordinate call
# hits the live PRM judge. When enabled=true (default), the cache
# short-circuits the LLM call for repeated {problem, reasoning, ...}
# inputs.
# AWARE_PRM_CACHE_ENABLED=true
# AWARE_PRM_CACHE_TTL_DAYS=30
# AWARE_PRM_CACHE_TABLE=aware_prm_cache

# ─────────────────────────────────────────────────────────────────────
# Budget watchdog (Phase 2.3)
# ─────────────────────────────────────────────────────────────────────
# The watchdog aggregates aware_conversations.cost_total_usd over a
# rolling window and trips a soft warning at softLimitUsd, a hard
# error at hardLimitUsd.
# AWARE_BUDGET_ENABLED=true
# AWARE_BUDGET_WINDOW_DAYS=30
# AWARE_BUDGET_SOFT_LIMIT_USD=80.0
# AWARE_BUDGET_HARD_LIMIT_USD=100.0

# ─────────────────────────────────────────────────────────────────────
# Trainer (Phase 3 — AZR self-play on Modal, Phase 4 — DPO outcome filter)
# ─────────────────────────────────────────────────────────────────────
# The trainer is a poller that watches Postgres for unconsumed preference
# pairs, packages them into a DPO dataset, and submits a Modal job.
# Disabled by default; opt in via the `training` compose profile.
# AWARE_TRAINER_ENABLED=false
# AWARE_TRAINER_POLL_INTERVAL_SEC=300
# AWARE_TRAINER_MIN_PAIRS_PER_RUN=100
# AWARE_TRAINER_CONFIG=config/modal-training.json
# AWARE_TRAINER_WEIGHTS_DIR=/root/aware-weights
# AWARE_TRAINER_BASE_MODEL=Qwen/trained-model
# AWARE_TRAINER_GPU_TYPE=A100-80GB
# AWARE_TRAINER_JOB_TIMEOUT_SEC=18000
#
# Phase 4 outcome filter (ADR-020 618-627). Default 'noop' = keep every
# pair. Flip to 'min_score_gap' or 'tag_match' once you have a working
# corpus and a real filter strategy. See src/trainer/outcome-filter.js
# for the full rule set.
# AWARE_TRAINER_FILTER_RULE=noop
# AWARE_TRAINER_FILTER_MIN_GAP=0.05
# AWARE_TRAINER_FILTER_ALLOWED_TASK_TYPES=
#
# Modal auth — read from the canonical credential store
# (<credential-store-file>) at runtime. NEVER in the repo.
# <redacted-credential-name>=replace-with-your-token-id
# <redacted-credential-name>=replace-with-your-token-secret

# ─────────────────────────────────────────────────────────────────────
# v1 fallback (legacy v1.0.0 stack — coexists with v2)
# ─────────────────────────────────────────────────────────────────────
# The v1 stack runs on the v1 ports (3000, 3001, etc.) and reads its own
# env vars. These are documented here for completeness but the v1 stack
# is shipped and stable — operators only need to touch v1 vars if they
# are upgrading from a v1.0.0 deployment.
# API_PORT=3000
# DISCOVERY_PORT=41234
# BROADCAST_PORT=41235
